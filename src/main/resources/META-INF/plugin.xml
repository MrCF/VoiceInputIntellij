<idea-plugin>

    <resource-bundle>messages.VoiceInputBundle</resource-bundle>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">

        <postStartupActivity implementation="it.federico.voiceinput.GpuAvailabilityStartupActivity"/>

        <statusBarWidgetFactory
                id="VoiceInputStatus"
                implementation="it.federico.voiceinput.VoiceStatusWidgetFactory"/>

        <applicationConfigurable
                parentId="tools"
                instance="it.federico.voiceinput.VoiceSettingsConfigurable"
                id="it.federico.voiceinput.settings"
                displayName="Voice Input"/>

        <toolWindow
                id="Voice Input History"
                anchor="right"
                factoryClass="it.federico.voiceinput.VoiceHistoryToolWindowFactory"/>
    </extensions>

    <actions>

        <action
                id="VoiceInputAction"
                class="it.federico.voiceinput.VoiceInputAction"
                text="Voice Input"
                description="Start or stop voice dictation">

            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="meta V"/>

        </action>

        <action
                id="VoiceInputPushToTalkAction"
                class="it.federico.voiceinput.PushToTalkAction"
                text="Voice Input: Push to Talk"
                description="Hold the microphone button to dictate"/>

    </actions>

</idea-plugin>
